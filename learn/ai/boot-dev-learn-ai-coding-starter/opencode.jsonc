{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-v4.1-flash-free",
  "watcher": {
    "ignore": [
      "logs/**",
    ],
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "settings": {
            "reasoning_effort": "none",
          },
          "body": {
            "temperature": 0.9,
          },
        },
      },
    },
  },
  "permissions": [
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "deny",
    },
    {
      "action": "subagent",
      "resource": "orchestrator-*",
      "effect": "allow",
    },
  ],
}
