module(
    name = "mono",
    version = "0.0.0",
)

bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "rules_nodejs", version = "6.7.7")

# Rust toolchain
rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    versions = ["1.99.0"],
)
use_repo(rust, "rust_toolchains")
register_toolchains("@rust_toolchains//:all")

# Third-party Rust crates, resolved from the root Cargo workspace.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

# Pin a hermetic Node toolchain for JavaScript build actions.
node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "22.23.4")

# Resolve the prompt-library app's pnpm lockfile to Bazel npm package targets.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "prompt_library_npm",
    bins = {
        "vite": ["vite=./bin/vite.js"],
    },
    pnpm_lock = "//learn/ai/fem_practical_prompt_engineering/prompt_library_app:pnpm-lock.yaml",
)
use_repo(npm, "prompt_library_npm")
