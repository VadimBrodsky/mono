{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek-v4.1-flash-free",
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 10000,
    },
    "buffer": 20000,
  },
  "watcher": {
    "ignore": ["logs/**"],
  },
  "providers": {
    "openai": {
      "models": {
        "gpt-5.6-luna": {
          "settings": {
            "reasoning_effort": "none",
          },
          "body": {
            "temperature": 0.9,
          },
        },
      },
    },
  },
  "permissions": [
    {
      "action": "run_slop",
      "resource": "*",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "*",
      "effect": "ask",
    },
    {
      "action": "shell",
      "resource": "bootdev run *",
      "effect": "allow",
    },
    {
      "action": "subagent",
      "resource": "explore",
      "effect": "deny",
    },
    {
      "action": "subagent",
      "resource": "orchestrator-*",
      "effect": "allow",
    },
    {
      "action": "read",
      "resource": "*.env",
      "effect": "deny",
    },
    {
      "action": "skill",
      "resource": "create-test-program",
      "effect": "ask",
    },
  ],
  "mcp": {
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp/oauth",
        "oauth": true,
      },
      "exa": {
        "type": "remote",
        "url": "https://mcp.exa.ai/mcp?login",
        "disabled": true,
      },
      "playwright": {
        "type": "local",
        "command": [
          "bunx",
          "--bun",
          "@playwright/mcp@0.0.80",
          "--isolated",
          "--browser",
          "chromium",
          "--caps=vision",
        ],
      },
    },
  },
}
