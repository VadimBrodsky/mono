# homelab/k8s/clusters/dev/BUILD.bazel
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

# Create kind cluster and seed its out-of-band 1Password token.
sh_binary(
    name = "up",
    srcs = ["up.sh"],
)

# destroy the cluster
sh_binary(
    name = "down",
    srcs = ["down.sh"],
)

# Install Flux and begin cluster reconciliation.
sh_binary(
    name = "flux",
    srcs = ["flux.sh"],
)
